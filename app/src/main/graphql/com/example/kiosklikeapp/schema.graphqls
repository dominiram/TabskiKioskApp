"""
**Doordash delivery cancelation statuses:** [
  "cancel_by_dispatch",
  "cancel_by_merchant",
  "cancel_by_order_placer",
  "customer_requested_other",
  "dasher_cannot_fulfill_other",
  "dasher_not_responding",
  "drive_order_picked_up_by_customer",
  "duplicate_order",
  "fraudulent_order",
  "items_temp_unavailable",
  "no_available_dashers",
  "nontablet_protocol_issue",
  "other",
  "picked_up_by_other_dasher",
  "store_cannot_fulfill_other",
  "store_closed",
  "test_order",
  "too_busy",
  "too_late",
  "wrong_delivery_address",
  "package_needs_redelivery",
  "package_never_received",
  "package_lost_at_facility",
]

**Uber delivery cancelation statuses:** [
"CANNOT_ACCESS_CUSTOMER_LOCATION",
"CANNOT_FIND_CUSTOMER_ADDRESS",
"CUSTOMER_REJECTED_ORDER",
"CUSTOMER_UNAVAILABLE",
"COURIER_CANCEL",
"MERCHANT_CANCEL",
"UBER_CANCEL",
]
"""
enum OrderDeliveryCancelationReasons {
  CANNOT_ACCESS_CUSTOMER_LOCATION

  CANNOT_FIND_CUSTOMER_ADDRESS

  COURIER_CANCEL

  CUSTOMER_REJECTED_ORDER

  CUSTOMER_UNAVAILABLE

  MERCHANT_CANCEL

  UBER_CANCEL

  cancel_by_dispatch

  cancel_by_merchant

  cancel_by_order_placer

  customer_requested_other

  dasher_cannot_fulfill_other

  dasher_not_responding

  drive_order_picked_up_by_customer

  duplicate_order

  fraudulent_order

  items_temp_unavailable

  no_available_dashers

  nontablet_protocol_issue

  other

  package_lost_at_facility

  package_needs_redelivery

  package_never_received

  picked_up_by_other_dasher

  store_cannot_fulfill_other

  store_closed

  test_order

  too_busy

  too_late

  wrong_delivery_address
}

"""
**Doordash delivery statuses:** ['quote', 'created', 'confirmed', 'enroute_to_pickup', 'arrived_at_pickup', 'picked_up', 'enroute_to_dropoff', 'arrived_at_dropoff', 'delivered', 'enroute_to_return', 'arrived_at_return', 'returned', 'cancelled']

**Uber delivery statuses:** ['pending', 'pickup', 'pickup_complete', 'dropoff', 'delivered', 'canceled', 'returned']
"""
enum OrderDeliveryStatuses {
  arrived_at_dropoff

  arrived_at_pickup

  arrived_at_return

  canceled

  cancelled

  confirmed

  created

  delivered

  dropoff

  enroute_to_dropoff

  enroute_to_pickup

  enroute_to_return

  pending

  picked_up

  pickup

  pickup_complete

  quote

  returned
}

enum OrderPaymentMethods {
  CLOVER

  PAYRIX
}

enum OrderStatuses {
  OPEN

  PARTIALLY_PAID

  PAID

  VOIDED

  PARTIALLY_REFUNDED

  REFUNDED
}

enum OrderDiscountTypes {
  DISCOUNT

  DYNAMIC_PRICE
}

type Order {
  additionalInfo: OrderAdditionalInfo!

  application: AppType!

  checks: [OrderCheck!]!

  consumerId: ID

  consumerName: String

  createdAt: DateTime!

  deliveryInfo: OrderDeliveryInfo

  employeeId: ID

  employeeName: String

  fee: Int!

  id: ID!

  isOpenTab: Boolean!

  items: [OrderItem!]!

  merchantId: ID!

  multimerchantId: ID

  posId: String

  referenceId: String!

  status: OrderStatuses

  type: String!

  updatedAt: DateTime!
}

type OrderAdditionalInfo {
  scheduleAt: DateTime

  specialInstructions: String
}

type OrderDeliveryInfo {
  consumerAddressId: ID

  deliveryCancelationReason: OrderDeliveryCancelationReasons

  deliveryFee: Int

  deliveryId: String

  deliveryProvider: DeliveryProvider

  deliveryQuoteId: String

  deliveryStatus: OrderDeliveryStatuses

  deliveryTip: Int

  dropoffTime: DateTime

  pickupTime: DateTime

  referenceId: String

  supportReference: String
}

type OrderType {
  id: ID!

  name: String!

  merchantId: ID!

  merchant: Merchant!

  tables: [Table]!

  createdAt: DateTime!

  updatedAt: DateTime!
}

input CreateOrderAdditionalInfoInput {
  scheduleAt: DateTime

  specialInstructions: String
}

input CreateOrderInput {
  additionalInfo: CreateOrderAdditionalInfoInput

